# Caddyfile for TuneBridge
# Provides secure reverse proxy with automatic HTTPS

{
    # Global options
    admin off
    # Persist data for certificates
    storage file_system /data/caddy
    # Enable auto HTTPS
    auto_https on
    # Email for Let's Encrypt notifications (override with CADDY_ADMIN_EMAIL env var)
    email {$CADDY_ADMIN_EMAIL:admin@tunebridge.media}
}

# Default site configuration
# Override DOMAIN with environment variable for production
{$DOMAIN:dev.tunebridge.media} {
    # Enable logging
    log {
        output file /var/log/caddy/access.log
        format json
    }

    # Security headers
    header {
        # Enable HSTS (HTTP Strict Transport Security)
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        
        # Prevent MIME type sniffing
        X-Content-Type-Options "nosniff"
        
        # Clickjacking protection
        X-Frame-Options "SAMEORIGIN"
        
        # XSS protection (legacy browsers)
        X-XSS-Protection "1; mode=block"
        
        # Referrer policy
        Referrer-Policy "strict-origin-when-cross-origin"
        
        # Content Security Policy
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'self';"
        
        # Permissions policy (formerly Feature-Policy)
        Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
        
        # Remove server identification
        -Server
        -X-Powered-By
    }

    # Rate limiting (optional, adjust as needed)
    # Uncomment to enable rate limiting at the proxy level
    # rate_limit {
    #     zone dynamic {
    #         key {remote_host}
    #         events 100
    #         window 1m
    #     }
    # }

    # Reverse proxy to TuneBridge application
    reverse_proxy localhost:10000 {
        # Health check endpoint
        health_uri /health
        health_interval 10s
        health_timeout 5s
        
        # Pass real client IP
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-Host {host}
        
        # Timeouts
        transport http {
            read_timeout 30s
            write_timeout 30s
            dial_timeout 5s
        }
    }

    # Custom error pages (optional)
    handle_errors {
        @5xx expression `{err.status_code} >= 500 && {err.status_code} < 600`
        handle @5xx {
            respond "Service temporarily unavailable. Please try again later." 503
        }
        
        @4xx expression `{err.status_code} >= 400 && {err.status_code} < 500`
        handle @4xx {
            respond "Request error. Please check your request and try again." {err.status_code}
        }
    }
}

# HTTP to HTTPS redirect for production
# This is handled automatically by Caddy when auto_https is enabled

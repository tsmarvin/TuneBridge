# TuneBridge Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================================================
# Domain Configuration
# ============================================================================
# Domain name for the application (used by Caddy for HTTPS certificates)
# For local development, use localhost or a custom hosts entry
# For production, use your actual domain name
DOMAIN=dev.tunebridge.media

# Email for Let's Encrypt certificate notifications
CADDY_ADMIN_EMAIL=admin@tunebridge.media

# ============================================================================
# Apple Music API Credentials
# ============================================================================
# Get these from: https://developer.apple.com/account
# Guide: https://developer.apple.com/help/account/configure-app-capabilities/create-a-media-identifier-and-private-key/
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Path to .p8 key file on host (for Docker secret)
APPLE_KEY_FILE=./secrets/apple_key.p8

# ============================================================================
# Spotify API Credentials
# ============================================================================
# Get these from: https://developer.spotify.com/dashboard
# Guide: https://developer.spotify.com/documentation/general/guides/app-settings/#register-your-app
SPOTIFY_CLIENT_ID=
# Path to secret file on host (for Docker secret)
SPOTIFY_CLIENT_SECRET_FILE=./secrets/spotify_client_secret.txt

# ============================================================================
# Tidal API Credentials
# ============================================================================
# Get these from: https://developer.tidal.com/
TIDAL_CLIENT_ID=
# Path to secret file on host (for Docker secret)
TIDAL_CLIENT_SECRET_FILE=./secrets/tidal_client_secret.txt

# ============================================================================
# Discord Bot Configuration (Optional)
# ============================================================================
# Get this from: https://discord.com/developers/applications
# Guide: https://discord.com/developers/docs/quick-start/getting-started
# Path to secret file on host (for Docker secret)
DISCORD_TOKEN_FILE=./secrets/discord_token.txt

# ============================================================================
# Bluesky PDS Configuration (Optional - for caching)
# ============================================================================
# PDS URL (usually https://bsky.social)
BLUESKY_PDS_URL=https://bsky.social
# Your Bluesky handle or DID
BLUESKY_IDENTIFIER=
# App password (generate at Settings → App Passwords)
# Path to secret file on host (for Docker secret)
BLUESKY_PASSWORD_FILE=./secrets/bluesky_password.txt

# ============================================================================
# Cache Configuration
# ============================================================================
# Number of days to cache Bluesky PDS lookup results
CACHE_DAYS=7
# Path to SQLite cache database
CACHE_DB_PATH=/app/data/tunebridge.db

# ============================================================================
# Database Configuration
# ============================================================================
# SQLite connection string for user authentication
CONNECTION_STRING=Data Source=/app/data/tunebridge.db

# ============================================================================
# Authentication and Rate Limiting
# ============================================================================
# Salt for API key hashing (generate a random string)
# Path to secret file on host (for Docker secret)
API_KEY_SALT_FILE=./secrets/api_key_salt.txt
# Number of requests allowed per hour per user
RATE_LIMIT_REQUESTS_PER_HOUR=20

# ============================================================================
# Application Configuration
# ============================================================================
# Discord shard node number
NODE_NUMBER=0
# Allowed hosts for the web server
ALLOWED_HOSTS=dev.tunebridge.media
# Default logging level
DEFAULT_LOGLEVEL=Information
# ASP.NET hosting logging level
HOSTING_DEFAULT_LOGLEVEL=Information

# BridgeBeats Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================================================
# Domain Configuration
# ============================================================================
# Domain name for the application (used by Caddy for HTTPS certificates)
# For local development, use localhost or a custom hosts entry
# For production, use your actual domain name
DOMAIN=bridgebeats.link
BASEURL=bridgebeats.link
SHORT_DOMAIN=bbeats.link


# Docker Hub username for pulling custom Caddy image
DOCKERHUB_USERNAME=tsmarvin

# Email for Let's Encrypt certificate notifications
CADDY_ADMIN_EMAIL=admin@bridgebeats.link


# ============================================================================
# Application Configuration
# ============================================================================
# Discord shard node number
NODE_NUMBER=0
# Default logging level
DEFAULT_LOGLEVEL=Information
# ASP.NET hosting logging level
HOSTING_DEFAULT_LOGLEVEL=Information


# ============================================================================
# Apple Music API Credentials
# ============================================================================
# Get these from: https://developer.apple.com/account
# Guide: https://developer.apple.com/help/account/configure-app-capabilities/create-a-media-identifier-and-private-key/
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Path to .p8 key file on host (for Docker secret)
APPLE_KEY_PATH=/run/secrets/apple_key


# ============================================================================
# Spotify API Credentials
# ============================================================================
# Get these from: https://developer.spotify.com/dashboard
# Guide: https://developer.spotify.com/documentation/general/guides/app-settings/#register-your-app
SPOTIFY_CLIENT_ID=


# ============================================================================
# Tidal API Credentials
# ============================================================================
# Get these from: https://developer.tidal.com/
TIDAL_CLIENT_ID=


# ============================================================================
# ATProto PDS Configuration (Optional - for caching)
# ============================================================================

PDS_HOSTNAME=pds.bridgebeats.link
# Your ATProto handle
ATPROTO_IDENTIFIER=
# Your ATProto did
ATPROTO_USER_DID=


# ============================================================================
# Cache Configuration
# ============================================================================
# Number of days to cache ATProto PDS lookup results
CACHE_DAYS=7
# Path to SQLite cache database
LINK_CACHE_CONNECTION_STRING=Data Source=/app/data/bridgebeats.db


# ============================================================================
# Database Configuration
# ============================================================================
# SQLite connection string for user authentication
IDENTITY_CONNECTION_STRING=Data Source=/app/data/bridgebeats.db


# ============================================================================
# Authentication and Rate Limiting
# ============================================================================
# Number of requests allowed per hour per user
RATE_LIMIT_REQUESTS_PER_HOUR=100


# ============================================================================
# PDS Info
# ============================================================================
PDS_JWT_SECRET=
PDS_PLC_ROTATION_KEY_K256_PRIVATE_KEY_HEX=

PDS_ADMIN_PASSWORD={PDS_ADMIN_PASSWORD}
PDS_EMAIL_SMTP_URL=smtp://pds@bridgebeats.link:{clientSecret}@smtp.azurecomm.net:587/
PDS_EMAIL_FROM_ADDRESS=DoNotReply@bridgebeats.link

CLOUDFLARE_API_TOKEN=

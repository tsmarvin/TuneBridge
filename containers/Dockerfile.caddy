# Dockerfile for Caddy with Cloudflare DNS plugin
# This image is built with the Cloudflare DNS module for ACME DNS-01 challenges
# Required for wildcard certificate support (*.domain.com)

FROM caddy:2-builder@sha256:01668408cc26e2e00c9d067c30cb43b2ba14ad1f2808beda55503cb2a31f59dc AS builder

# Build Caddy with Cloudflare DNS plugin
RUN xcaddy build --with github.com/caddy-dns/cloudflare

FROM caddy:2@sha256:c3d7ee5d2b11f9dc54f947f68a734c84e9c9666c92c88a7f30b9cba5da182adb

# Copy custom Caddy binary with Cloudflare plugin
COPY --from=builder /usr/bin/caddy /usr/bin/caddy

# Verify the binary works
RUN caddy version

# Default ports
EXPOSE 80 443

# Default command
CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]

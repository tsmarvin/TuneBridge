@{
    ViewData["Title"] = "User Settings";
}

<div class="card mb-4">
    <div class="card-body">
        <h2 class="card-title">User Settings</h2>

        <div id="userInfo" class="mb-4">
            <h5>Account Information</h5>
            <div class="mb-2">
                <strong>Email:</strong> <span id="userEmail">Loading...</span>
            </div>
            <div class="mb-2">
                <strong>User ID:</strong> <span id="userId" class="font-monospace">Loading...</span>
            </div>
        </div>

        <hr />

        <div id="apiKeySection">
            <h5>API Key Management</h5>
            <p class="text-muted">
                Your API key is used to authenticate API requests. Keep it secure and never share it publicly.
            </p>

            <div id="apiKeyDisplay" class="d-none mb-3">
                <div class="alert alert-success">
                    <strong>New API Key Generated Successfully!</strong>
                </div>
                <p><strong>Your New API Key:</strong></p>
                <div class="bg-body-secondary p-3 rounded font-monospace mb-3" id="newApiKey"></div>
                <div class="alert alert-warning">
                    <strong>⚠️ Important Security Information:</strong>
                    <ul class="mb-0">
                        <li>Save this API key now - it will not be shown again</li>
                        <li>Your old API key has been invalidated and will no longer work</li>
                        <li>Update all applications using the old key with this new key</li>
                        <li>Use the header <code>X-API-Key: [your-key]</code> for authentication</li>
                        <li>Never commit API keys to source code or share them publicly</li>
                    </ul>
                    <div>
                        <button onclick="window.location.href='/'" class="btn btn-primary">Go to Music Lookup</button>
                        <a href="/swagger">View API Documentation (Swagger)</a>
                    </div>
                </div>
            </div>

            <div id="resetSection">
                <button id="resetApiKeyBtn" class="btn btn-warning">
                    Reset API Key
                </button>
                <div class="form-text">
                    Generate a new API key and invalidate the current one. Use this if your key is compromised.
                </div>
            </div>

            <div id="error" class="alert alert-danger d-none mt-3"></div>
        </div>
        <hr />

        <div id="dataManagementSection">
            <h5>Data Management</h5>
            <p class="text-muted">
                Manage your personal data and account.
            </p>

            <div class="mb-3">
                <button id="downloadDataBtn" class="btn btn-info">
                    Download My Data
                </button>
                <div class="form-text">
                    Export a copy of all your personal data in JSON format. This includes your account information and
                    metadata.
                </div>
            </div>

            <div id="downloadDataError" class="alert alert-danger d-none mt-3"></div>
        </div>

        <hr />

        <div id="accountDeletionSection">
            <h5 class="text-danger">Danger Zone</h5>
            <p class="text-muted">
                Permanently delete your account and all associated data.
            </p>

            <div class="mb-3">
                <button id="deleteAccountBtn" class="btn btn-danger">
                    Delete My Account
                </button>
                <div class="form-text">
                    This action is permanent and cannot be undone. All your data will be permanently removed.
                </div>
            </div>

            <div id="deleteAccountError" class="alert alert-danger d-none mt-3"></div>
        </div>
    </div>
</div>

<!-- API Key Reset Modal -->
<div id="confirmModal" class="modal" tabindex="-1" role="dialog" aria-labelledby="confirmModalTitle" aria-hidden="true"
     style="display: none;">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 id="confirmModalTitle" class="modal-title">Confirm API Key Reset</h5>
                <button type="button" class="btn-close" data-dismiss="modal" aria-label="Close" id="modalCloseBtn">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <p><strong>Are you sure you want to reset your API key?</strong></p>
                <p>This action will:</p>
                <ul>
                    <li>Generate a new API key</li>
                    <li>Invalidate your current API key immediately</li>
                    <li>Require you to update all applications using the old key</li>
                </ul>
                <p class="text-danger"><strong>This action cannot be undone.</strong></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal" id="modalCancelBtn">Cancel</button>
                <button type="button" class="btn btn-danger" id="modalConfirmBtn">Reset API Key</button>
            </div>
        </div>
    </div>
</div>

<!-- Account Deletion Modal -->
<div id="deleteConfirmModal" class="modal" tabindex="-1" role="dialog" aria-labelledby="deleteConfirmModalTitle"
     aria-hidden="true" style="display: none;">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 id="deleteConfirmModalTitle" class="modal-title">Confirm Account Deletion</h5>
                <button type="button" class="btn-close" data-dismiss="modal" aria-label="Close"
                        id="deleteModalCloseBtn">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <p><strong>Are you sure you want to delete your account?</strong></p>
                <p>This action will:</p>
                <ul>
                    <li>Permanently delete your account</li>
                    <li>Remove all your personal data</li>
                    <li>Invalidate your API key</li>
                    <li>Cancel any active sessions</li>
                </ul>
                <p class="text-danger"><strong>⚠️ This action is permanent and cannot be undone.</strong></p>
                <hr />
                <div class="form-group">
                    <label for="deleteConfirmEmail">To confirm deletion, please type your email address:</label>
                    <input type="email" class="form-control mt-2" id="deleteConfirmEmail" placeholder="your@email.com">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal"
                        id="deleteModalCancelBtn">
                    Cancel
                </button>
                <button type="button" class="btn btn-danger" id="deleteModalConfirmBtn" disabled>Delete Account</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const userEmailEl = document.getElementById('userEmail');
        const userIdEl = document.getElementById('userId');
        const resetApiKeyBtn = document.getElementById('resetApiKeyBtn');
        const downloadDataBtn = document.getElementById('downloadDataBtn');
        const deleteAccountBtn = document.getElementById('deleteAccountBtn');
        const error = document.getElementById('error');
        const downloadDataError = document.getElementById('downloadDataError');
        const deleteAccountError = document.getElementById('deleteAccountError');
        const apiKeyDisplay = document.getElementById('apiKeyDisplay');
        const newApiKeyEl = document.getElementById('newApiKey');
        const resetSection = document.getElementById('resetSection');

        // API Key Reset Modal elements
        const confirmModal = document.getElementById('confirmModal');
        const modalConfirmBtn = document.getElementById('modalConfirmBtn');
        const modalCancelBtn = document.getElementById('modalCancelBtn');
        const modalCloseBtn = document.getElementById('modalCloseBtn');

        // Account Deletion Modal elements
        const deleteConfirmModal = document.getElementById('deleteConfirmModal');
        const deleteModalConfirmBtn = document.getElementById('deleteModalConfirmBtn');
        const deleteModalCancelBtn = document.getElementById('deleteModalCancelBtn');
        const deleteModalCloseBtn = document.getElementById('deleteModalCloseBtn');
        const deleteConfirmEmail = document.getElementById('deleteConfirmEmail');

        // Load user info
        async function loadUserInfo() {
            try {
                const response = await fetch('/account/status', { credentials: 'same-origin' });
                const data = await response.json();

                if (!data.isAuthenticated) {
                    window.location.href = '/account/login';
                    return;
                }

                userEmailEl.textContent = data.email || 'N/A';
                userIdEl.textContent = data.userId || 'N/A';
            } catch (err) {
                error.textContent = 'Failed to load user information: ' + err.message;
                error.classList.remove('d-none');
            }
        }

        // Modal functions for API Key Reset
        function showResetModal() {
            confirmModal.style.display = 'block';
            confirmModal.setAttribute('aria-hidden', 'false');
            setTimeout(() => modalConfirmBtn.focus(), 100);
            document.body.style.overflow = 'hidden';
        }

        function hideResetModal() {
            confirmModal.style.display = 'none';
            confirmModal.setAttribute('aria-hidden', 'true');
            document.body.style.overflow = '';
            resetApiKeyBtn.focus();
        }

        // Modal functions for Account Deletion
        function showDeleteModal() {
            deleteConfirmModal.style.display = 'block';
            deleteConfirmModal.setAttribute('aria-hidden', 'false');
            deleteConfirmEmail.value = '';
            deleteModalConfirmBtn.disabled = true;
            setTimeout(() => deleteConfirmEmail.focus(), 100);
            document.body.style.overflow = 'hidden';
        }

        function hideDeleteModal() {
            deleteConfirmModal.style.display = 'none';
            deleteConfirmModal.setAttribute('aria-hidden', 'true');
            document.body.style.overflow = '';
            deleteAccountBtn.focus();
        }

        // Event listeners for API Key Reset Modal
        resetApiKeyBtn.addEventListener('click', () => {
            error.classList.add('d-none');
            showResetModal();
        });

        modalConfirmBtn.addEventListener('click', () => {
            hideResetModal();
            resetApiKey();
        });

        modalCancelBtn.addEventListener('click', hideResetModal);
        modalCloseBtn.addEventListener('click', hideResetModal);

        // Event listeners for Account Deletion Modal
        deleteAccountBtn.addEventListener('click', () => {
            deleteAccountError.classList.add('d-none');
            showDeleteModal();
        });

        deleteModalConfirmBtn.addEventListener('click', () => {
            hideDeleteModal();
            deleteAccount();
        });

        deleteModalCancelBtn.addEventListener('click', hideDeleteModal);
        deleteModalCloseBtn.addEventListener('click', hideDeleteModal);

        // Close modals on Escape key
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                if (confirmModal.style.display === 'block') {
                    hideResetModal();
                }
                if (deleteConfirmModal.style.display === 'block') {
                    hideDeleteModal();
                }
            }
        });

        // Close modals when clicking outside
        confirmModal.addEventListener('click', (e) => {
            if (e.target === confirmModal) {
                hideResetModal();
            }
        });

        deleteConfirmModal.addEventListener('click', (e) => {
            if (e.target === deleteConfirmModal) {
                hideDeleteModal();
            }
        });

        // Enable/disable delete button based on email confirmation
        deleteConfirmEmail.addEventListener('input', () => {
            const userEmail = userEmailEl.textContent;
            const confirmEmail = deleteConfirmEmail.value.trim();
            deleteModalConfirmBtn.disabled = confirmEmail !== userEmail;
        });

        // Download personal data
        downloadDataBtn.addEventListener('click', async () => {
            downloadDataError.classList.add('d-none');
            downloadDataBtn.disabled = true;
            downloadDataBtn.textContent = 'Downloading...';

            try {
                const response = await fetch('/account/download-data', {
                    method: 'POST',
                    credentials: 'same-origin'
                });

                if (!response.ok) {
                    const data = await response.json();
                    downloadDataError.textContent = data.message || 'Failed to download personal data';
                    downloadDataError.classList.remove('d-none');
                    downloadDataBtn.disabled = false;
                    downloadDataBtn.textContent = 'Download My Data';
                    return;
                }

                // Get the filename from Content-Disposition header
                const contentDisposition = response.headers.get('content-disposition');
                let filename = 'tunebridge-personal-data.json';
                if (contentDisposition && contentDisposition.includes('filename=')) {
                    filename = contentDisposition
                        .split('filename=')[1]
                        .split(';')[0]
                        .replace(/"/g, '');
                }

                // Download the file
                const blob = await response.blob();
                const url = window.URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = filename;
                document.body.appendChild(a);
                a.click();
                window.URL.revokeObjectURL(url);
                document.body.removeChild(a);

                downloadDataBtn.disabled = false;
                downloadDataBtn.textContent = 'Download My Data';
            } catch (err) {
                console.error('Download data error:', err);
                downloadDataError.textContent = 'Network error: ' + err.message;
                downloadDataError.classList.remove('d-none');
                downloadDataBtn.disabled = false;
                downloadDataBtn.textContent = 'Download My Data';
            }
        });

        // Delete account
        async function deleteAccount() {
            deleteAccountError.classList.add('d-none');
            deleteAccountBtn.disabled = true;
            deleteAccountBtn.textContent = 'Deleting...';

            try {
                const response = await fetch('/account/delete', {
                    method: 'POST',
                    credentials: 'same-origin'
                });

                const data = await response.json();

                if (!response.ok) {
                    deleteAccountError.textContent = data.message || 'Failed to delete account';
                    deleteAccountError.classList.remove('d-none');
                    deleteAccountBtn.disabled = false;
                    deleteAccountBtn.textContent = 'Delete My Account';
                    return;
                }

                // Show success message and redirect
                alert('Your account has been successfully deleted. You will be redirected to the home page.');
                window.location.href = '/';

            } catch (err) {
                console.error('Delete account error:', err);
                deleteAccountError.textContent = 'Network error: ' + err.message;
                deleteAccountError.classList.remove('d-none');
                deleteAccountBtn.disabled = false;
                deleteAccountBtn.textContent = 'Delete My Account';
            }
        }

        // Reset API key
        async function resetApiKey() {
            error.classList.add('d-none');
            resetApiKeyBtn.disabled = true;
            resetApiKeyBtn.textContent = 'Resetting...';

            try {
                const response = await fetch('/account/regenerate-api-key', {
                    method: 'POST',
                    credentials: 'same-origin'
                });

                const data = await response.json();

                if (!response.ok) {
                    error.textContent = data.message || 'Failed to reset API key';
                    error.classList.remove('d-none');
                    resetApiKeyBtn.disabled = false;
                    resetApiKeyBtn.textContent = 'Reset API Key';
                    return;
                }

                // Show new API key
                newApiKeyEl.textContent = data.apiKey;
                apiKeyDisplay.classList.remove('d-none');
                resetSection.classList.add('d-none');

                // Scroll to show the new key with fallback for older browsers
                try {
                    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
                    apiKeyDisplay.scrollIntoView({ behavior: prefersReducedMotion ? 'auto' : 'smooth', block: 'nearest' });
                } catch (e) {
                    apiKeyDisplay.scrollIntoView();
                }

            } catch (err) {
                console.error('Reset API key error:', err);
                error.textContent = 'Network error: ' + err.message;
                error.classList.remove('d-none');
                resetApiKeyBtn.disabled = false;
                resetApiKeyBtn.textContent = 'Reset API Key';
            }
        }

        // Initialize
        loadUserInfo();
    </script>
}

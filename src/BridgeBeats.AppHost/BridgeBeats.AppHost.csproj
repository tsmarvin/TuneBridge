<Project Sdk="Microsoft.NET.Sdk">
  <Sdk Name="Aspire.AppHost.Sdk" Version="13.1.0" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <UserSecretsId>bridgebeats-apphost</UserSecretsId>
    <RepositoryUrl>https://github.com/tsmarvin/BridgeBeats</RepositoryUrl>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DebugType>embedded</DebugType>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Redis" Version="13.1.0" />
    <PackageReference Include="Aspire.Dashboard.Sdk.linux-x64" Version="13.1.0" Condition="'$(RuntimeIdentifier)' == 'linux-x64' Or '$(RuntimeIdentifier)' == ''" />
    <PackageReference Include="Aspire.Dashboard.Sdk.linux-arm64" Version="13.1.0" Condition="'$(RuntimeIdentifier)' == 'linux-arm64'" />
    <PackageReference Include="Aspire.Dashboard.Sdk.win-x64" Version="13.1.0" Condition="'$(RuntimeIdentifier)' == 'win-x64'" />
    <PackageReference Include="Aspire.Dashboard.Sdk.win-arm64" Version="13.1.0" Condition="'$(RuntimeIdentifier)' == 'win-arm64'" />
    <PackageReference Include="Aspire.Dashboard.Sdk.osx-arm64" Version="13.1.0" Condition="'$(RuntimeIdentifier)' == 'osx-arm64'" />
    <PackageReference Include="Aspire.Dashboard.Sdk.osx-x64" Version="13.1.0" Condition="'$(RuntimeIdentifier)' == 'osx-x64'" />
    <ProjectReference Include="..\BridgeBeats.Web\BridgeBeats.Web.csproj" />
    <ProjectReference Include="..\BridgeBeats.Worker.Discord\BridgeBeats.Worker.Discord.csproj" />
    <ProjectReference Include="..\BridgeBeats.Worker.Spotify\BridgeBeats.Worker.Spotify.csproj" />
    <ProjectReference Include="..\BridgeBeats.Worker.AppleMusic\BridgeBeats.Worker.AppleMusic.csproj" />
    <ProjectReference Include="..\BridgeBeats.Worker.Tidal\BridgeBeats.Worker.Tidal.csproj" />
    <ProjectReference Include="..\BridgeBeats.Worker.SagaCoordinator\BridgeBeats.Worker.SagaCoordinator.csproj" />
    <ProjectReference Include="..\BridgeBeats.Worker.JetStreamWatcher\BridgeBeats.Worker.JetStreamWatcher.csproj" />
    <ProjectReference Include="..\BridgeBeats.Worker.CacheBootstrap\BridgeBeats.Worker.CacheBootstrap.csproj" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <!-- Shared package dependency for ATProto records - provides AtProtoRecord base class -->
  <ItemGroup>
    <PackageReference Include="idunno.AtProto" Version="1.3.0" />
    <PackageReference Include="idunno.Bluesky" Version="1.3.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BridgeBeats" />
    <InternalsVisibleTo Include="BridgeBeats.Infrastructure" />
    <InternalsVisibleTo Include="BridgeBeats.Providers" />
    <InternalsVisibleTo Include="BridgeBeats.Services" />
    <InternalsVisibleTo Include="BridgeBeats.Tests" />
  </ItemGroup>

</Project>

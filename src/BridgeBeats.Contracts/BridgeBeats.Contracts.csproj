<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RepositoryUrl>https://github.com/tsmarvin/BridgeBeats</RepositoryUrl>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DebugType>embedded</DebugType>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- Shared package dependency for ATProto records - provides AtProtoRecord base class -->
  <ItemGroup>
    <PackageReference Include="idunno.AtProto" Version="3.0.0" />
    <PackageReference Include="idunno.Bluesky" Version="3.0.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BridgeBeats.Web" />
    <InternalsVisibleTo Include="BridgeBeats.Core" />
    <InternalsVisibleTo Include="BridgeBeats.Tests" />
  </ItemGroup>

</Project>

@{
    ViewData["Title"] = "Music Lookup";
}

<div class="card mb-4">
    <div class="card-body">
        <h2 class="card-title">Music Lookup</h2>

        <fieldset class="mb-3">
            <legend>Mode</legend>
            <div class="d-flex gap-3 flex-wrap">
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="mode" id="urlRadio" value="url" checked />
                    <label class="form-check-label" for="urlRadio">URL</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="mode" id="isrcRadio" value="isrc" />
                    <label class="form-check-label" for="isrcRadio">
                        ISRC <span class="badge bg-secondary login-required">
                            Login
                            required
                        </span>
                    </label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="mode" id="upcRadio" value="upc" />
                    <label class="form-check-label" for="upcRadio">
                        UPC <span class="badge bg-secondary login-required">
                            Login
                            required
                        </span>
                    </label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="mode" id="titleRadio" value="title" />
                    <label class="form-check-label" for="titleRadio">
                        Title <span class="badge bg-secondary login-required">
                            Login
                            required
                        </span>
                    </label>
                </div>
            </div>
        </fieldset>

        <div id="inputs" class="mb-3">
            <form id="lookupForm" asp-controller="Home" asp-action="LookupResults" method="post">
                <div id="urlRow" class="mb-3">
                    <input id="url" name="uri" type="text" class="form-control" placeholder="Url" />
                </div>

                <div id="isrcRow" class="mb-3 d-none">
                    <input id="isrc" type="text" class="form-control" placeholder="ISRC (e.g., USVI20000123)" />
                </div>

                <div id="upcRow" class="mb-3 d-none">
                    <input id="upc" type="text" class="form-control" placeholder="UPC (12–14 digits)" />
                </div>

                <div id="titleRow" class="mb-3 d-none">
                    <div class="row g-2">
                        <div class="col-12 col-md-6">
                            <input id="title" type="text" class="form-control" placeholder="Title" />
                        </div>
                        <div class="col-12 col-md-6">
                            <input id="artist" type="text" class="form-control" placeholder="Artist" />
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2 align-items-center">
                    <button id="go" type="submit" class="btn btn-primary">Go</button>
                    <span id="status" class="text-muted"></span>
                </div>
            </form>
        </div>

        <div>
            <h3>Results</h3>
            <div id="resultContainer">
                <pre id="result" class="bg-body-secondary p-3 rounded" aria-live="polite">{}</pre>
                <div id="cardsContainer"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
          const $ = (id) => document.getElementById(id);
          const modeRadios = Array.from(document.querySelectorAll('input[name="mode"]'));
          const protectedModes = ['isrc', 'upc', 'title'];
          const radioIds = { url: 'urlRadio', isrc: 'isrcRadio', upc: 'upcRadio', title: 'titleRadio' };

          const HIDDEN_CLASS = 'd-none';

          const urlRow = $('urlRow');
          const isrcRow = $('isrcRow');
          const upcRow = $('upcRow');
          const titleRow = $('titleRow');
          const lookupForm = $('lookupForm');

          let isAuthenticated = false;

          // Check auth status to enable/disable protected modes
          fetch('/account/status', { credentials: 'same-origin' })
            .then(res => res.json())
            .then(data => { isAuthenticated = data.isAuthenticated; updateUI(); })
            .catch(() => { isAuthenticated = false; updateUI(); });

          function updateUI() {
            // disable protected radios + show hint when logged out
            ['isrc', 'upc', 'title'].forEach(mode => {
              const radio = document.getElementById(radioIds[mode]);
              const label = document.querySelector(`label[for="${radioIds[mode]}"]`);
              if (!radio || !label) return;
              radio.disabled = !isAuthenticated;
              label.classList.toggle('disabled', !isAuthenticated);
            });
          }

          function setMode(mode) {
            if (!isAuthenticated && protectedModes.includes(mode)) { $(radioIds.url).checked = true; mode = 'url'; }
            urlRow.classList.toggle(HIDDEN_CLASS, mode !== 'url');
            isrcRow.classList.toggle(HIDDEN_CLASS, mode !== 'isrc');
            upcRow.classList.toggle(HIDDEN_CLASS, mode !== 'upc');
            titleRow.classList.toggle(HIDDEN_CLASS, mode !== 'title');
          }

          modeRadios.forEach(r => r.addEventListener('change', (e) => setMode(e.target.value)));
          setMode('url');

          // Handle form submission for all modes with server-side rendering
          lookupForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const mode = (modeRadios.find(r => r.checked) || {}).value;
            const status = $('status');
            const result = $('result');
            const cardsContainer = $('cardsContainer');
            
            status.textContent = 'Working...';
            lookupForm.querySelector('button[type="submit"]').disabled = true;
            result.textContent = '{}';
            result.classList.add('d-none');
            cardsContainer.innerHTML = '';

            try {
              // All modes now use server-side rendering with form data
              let endpoint = lookupForm.action;
              const formData = new FormData();
              
              switch (mode) {
                case 'url':
                  endpoint = '/Home/LookupResults';
                  formData.append('uri', $('url').value);
                  break;
                case 'isrc':
                  endpoint = '/Home/LookupResultsByIsrc';
                  formData.append('isrc', $('isrc').value);
                  break;
                case 'upc':
                  endpoint = '/Home/LookupResultsByUpc';
                  formData.append('upc', $('upc').value);
                  break;
                case 'title':
                  endpoint = '/Home/LookupResultsByTitle';
                  formData.append('title', $('title').value);
                  formData.append('artist', $('artist').value);
                  break;
              }
              
              const res = await fetch(endpoint, {
                method: 'POST',
                body: formData,
                credentials: 'same-origin'
              });

              if (res.ok) {
                const html = await res.text();
                cardsContainer.innerHTML = html;
                status.textContent = 'OK';
              } else if (res.status === 401) {
                result.textContent = JSON.stringify({ error: 'Authentication required', message: 'Please login to access this endpoint.' }, null, 2);
                result.classList.remove('d-none');
                status.textContent = 'HTTP 401 - Unauthorized';
              } else if (res.status === 429) {
                const data = await res.json().catch(() => ({ error: 'Rate limit exceeded' }));
                result.textContent = JSON.stringify(data, null, 2);
                result.classList.remove('d-none');
                status.textContent = 'HTTP 429 - Rate Limit Exceeded';
              } else {
                result.textContent = JSON.stringify({ error: `HTTP ${res.status}` }, null, 2);
                result.classList.remove('d-none');
                status.textContent = `HTTP ${res.status}`;
              }
            } catch (err) {
              status.textContent = 'Error';
              result.textContent = JSON.stringify({ error: String(err) }, null, 2);
              result.classList.remove('d-none');
            } finally {
              lookupForm.querySelector('button[type="submit"]').disabled = false;
            }
          });
        })();
    </script>
}

@model TuneBridge.Web.Models.MusicLookupViewModel
@using TuneBridge.Domain.Types.Enums
@using Microsoft.AspNetCore.Html

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-info">@Model.Message</div>
}
else if (Model.Items.Any())
{
    @if (Model.Items.Count > 1 && !string.IsNullOrWhiteSpace(Model.MultiCardUrl))
    {
        <div class="mb-3 d-flex justify-content-end">
            <div class="share-results-dropdown">
                <button class="btn btn-outline-primary share-results-button" type="button" aria-expanded="false" aria-haspopup="true">
                    <img src="/public/Share_arrow.png" alt="" class="share-arrow-icon me-1" />
                    Share All Results
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li>
                        <button class="dropdown-item copy-multi-link-btn" type="button" data-multi-card-url="@Model.MultiCardUrl">
                            <span class="dropdown-icon">📋</span> Copy Share Link
                        </button>
                    </li>
                    <li>
                        <button class="dropdown-item copy-multi-embed-btn" type="button" data-multi-card-url="@Model.MultiCardUrl" data-result-count="@Model.Items.Count">
                            <span class="dropdown-icon">🖼️</span> Copy Embed Code
                        </button>
                    </li>
                </ul>
            </div>
        </div>
    }
    
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
        @foreach (var item in Model.Items)
        {
            var borderColor = GetProviderColor(item.PrimaryProvider);
            <div class="col">
                <div class="embed-card h-100" style="border-left-color: @borderColor;">
                    <div class="embed-header-top">
                        <div class="embed-title-row">
                            @if (!string.IsNullOrWhiteSpace(item.CardUrl))
                            {
                                <a href="@item.CardUrl" target="_blank" rel="noopener noreferrer" class="embed-title">
                                    @(item.PrimaryResult.Title ?? "Unknown Title")
                                </a>
                            }
                            else
                            {
                                <div class="embed-title">@(item.PrimaryResult.Title ?? "Unknown Title")</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(item.CardUrl))
                            {
                                <div class="share-dropdown">
                                    <button class="share-button" type="button" aria-expanded="false" aria-haspopup="true" title="Share">
                                        <img src="/public/Share_arrow.png" alt="Share" class="share-arrow-icon" />
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li>
                                            <button class="dropdown-item copy-link-btn" type="button" data-url="@item.CardUrl">
                                                <span class="dropdown-icon">📋</span> Copy Link
                                            </button>
                                        </li>
                                        <li>
                                            <button class="dropdown-item copy-embed-btn" type="button" data-url="@item.CardUrl" data-title="@Html.Raw(System.Text.Json.JsonSerializer.Serialize(item.PrimaryResult.Title ?? "Music Link"))">
                                                <span class="dropdown-icon">🖼️</span> Copy Embed
                                            </button>
                                        </li>
                                        @if (!string.IsNullOrWhiteSpace(item.ATProtoUri))
                                        {
                                            <li>
                                                <button class="dropdown-item copy-atproto-btn" type="button" data-uri="@item.ATProtoUri">
                                                    <span class="dropdown-icon">🔗</span> Copy ATProto URI
                                                </button>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="embed-header">
                        @if (!string.IsNullOrWhiteSpace(item.PrimaryResult.ArtUrl))
                        {
                            @if (!string.IsNullOrWhiteSpace(item.CardUrl))
                            {
                                <a href="@item.CardUrl" target="_blank" rel="noopener noreferrer">
                                    <img src="@item.PrimaryResult.ArtUrl" alt="@item.PrimaryResult.Title artwork" class="embed-image" />
                                </a>
                            }
                            else
                            {
                                <img src="@item.PrimaryResult.ArtUrl" alt="@item.PrimaryResult.Title artwork" class="embed-image" />
                            }
                        }
                        <div class="embed-content">
                            <div class="embed-info">
                                Artist: @(item.PrimaryResult.Artist ?? "Unknown")
                                @if (!string.IsNullOrWhiteSpace(item.PrimaryResult.ExternalId))
                                {
                                    var idType = item.PrimaryResult.IsAlbum == true ? "UPC" : "ISRC";
                                    <text><br /></text>@idType<text>: </text>@item.PrimaryResult.ExternalId
                                }
                            </div>
                        </div>
                    </div>
                    <div class="embed-providers">
                        @foreach (var providerResult in item.Result.Results)
                        {
                            <a href="@providerResult.Value.URL" target="_blank" rel="noopener noreferrer" class="provider-button">
                                <span class="provider-icon provider-icon-@providerResult.Key.ToString().ToLowerInvariant()">
                                    @GetProviderLogo(providerResult.Key)
                                </span>
                                <span class="visually-hidden">@GetProviderName(providerResult.Key)</span>
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

@functions {
    IHtmlContent GetProviderLogo(SupportedProviders provider)
    {
        // Dark backgrounds need LIGHT logos, light backgrounds need DARK logos
        var darkThemeLogo = provider switch
        {
            SupportedProviders.AppleMusic => "/public/providerIcons/US-UK_Apple_Music_Listen_on_Lockup_RGB_wht_072720.svg",
            SupportedProviders.Spotify => "/public/providerIcons/Spotify_Full_Logo_Green_RGB.svg",
            SupportedProviders.Tidal => "/public/providerIcons/tidal-horizontal-white-cmyk.png",
            _ => ""
        };

        var lightThemeLogo = provider switch
        {
            SupportedProviders.AppleMusic => "/public/providerIcons/US-UK_Apple_Music_Listen_on_Lockup_RGB_blk_072720.svg",
            SupportedProviders.Spotify => "/public/providerIcons/Spotify_Full_Logo_Green_CMYK.svg",
            SupportedProviders.Tidal => "/public/providerIcons/tidal-horizontal-black-cmyk.png",
            _ => ""
        };

        if (string.IsNullOrEmpty(lightThemeLogo))
        {
            return new HtmlString("🎧");
        }

        var altText = GetProviderName(provider) + " logo";

        // Return both images with classes for CSS-based theme switching
        return new HtmlString($@"<img src=""{lightThemeLogo}"" alt=""{altText}"" class=""provider-logo provider-logo-light"" /><img src=""{darkThemeLogo}"" alt=""{altText}"" class=""provider-logo provider-logo-dark"" />");
    }

    string GetProviderName(SupportedProviders provider)
    {
        return provider switch
        {
            SupportedProviders.Spotify => "Spotify",
            SupportedProviders.AppleMusic => "Apple Music",
            SupportedProviders.Tidal => "Tidal",
            _ => provider.ToString()
        };
    }

    string GetProviderColor(SupportedProviders provider)
    {
        return provider switch
        {
            SupportedProviders.AppleMusic => "#D60017",
            SupportedProviders.Spotify => "#1ED760",
            SupportedProviders.Tidal => "#000000",
            _ => "#6366F1"
        };
    }
}

@model TuneBridge.Web.Controllers.TidalController.TidalViewModel
@{
    ViewData["Title"] = "Tidal Playlists";
}

<div class="card mb-4">
    <div class="card-body">
        <h2 class="card-title">Tidal Playlists</h2>

        <div id="userInfo" class="mb-4">
            <h5>Account Information</h5>
            <div class="mb-2">
                <strong>Email:</strong> <span>@Model.Email</span>
            </div>
            <div class="mb-2">
                <strong>Tidal Status:</strong>
                <span id="tidalStatus" class="badge @(Model.IsConnected ? "bg-success" : "bg-secondary")">
                    @(Model.IsConnected ? "Connected" : "Not Connected")
                </span>
            </div>
        </div>

        <hr />

        @if (!Model.IsConnected) {
            <div id="connectSection">
                <h5>Connect to Tidal</h5>
                <p class="text-muted">
                    Connect your Tidal account to view and select your playlists.
                </p>
                <a href="/tidal/connect" class="btn btn-primary">Connect to Tidal</a>
            </div>
        } else {
            <div id="playlistSection">
                <h5>Your Playlists</h5>
                <p class="text-muted">
                    Select a playlist to view its details.
                </p>

                <div class="mb-3">
                    <button id="loadPlaylistsBtn" class="btn btn-primary">Load Playlists</button>
                    <form method="post" action="/tidal/disconnect" class="d-inline">
                        <button type="submit" class="btn btn-secondary">Disconnect Tidal</button>
                    </form>
                </div>

                <div id="playlistsLoading" class="d-none">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <span class="ms-2">Loading playlists...</span>
                </div>

                <div id="playlistsError" class="alert alert-danger d-none"></div>

                <div id="playlistsList" class="list-group">
                    <!-- Playlists will be populated here -->
                </div>

                <div id="selectedPlaylist" class="mt-3 d-none">
                    <div class="alert alert-info">
                        <strong>Selected Playlist:</strong> <span id="selectedPlaylistName"></span>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    @if (Model.IsConnected) {
        <script>
            const loadPlaylistsBtn = document.getElementById('loadPlaylistsBtn');
            const playlistsLoading = document.getElementById('playlistsLoading');
            const playlistsError = document.getElementById('playlistsError');
            const playlistsList = document.getElementById('playlistsList');
            const selectedPlaylist = document.getElementById('selectedPlaylist');
            const selectedPlaylistName = document.getElementById('selectedPlaylistName');

            let currentSelectedId = null;

            loadPlaylistsBtn.addEventListener('click', async () => {
                playlistsError.classList.add('d-none');
                playlistsList.innerHTML = '';
                selectedPlaylist.classList.add('d-none');
                loadPlaylistsBtn.disabled = true;
                playlistsLoading.classList.remove('d-none');

                try {
                    const response = await fetch('/tidal/playlists', {
                        credentials: 'same-origin'
                    });

                    if (!response.ok) {
                        const data = await response.json();
                        playlistsError.textContent = data.error || 'Failed to load playlists';
                        playlistsError.classList.remove('d-none');
                        return;
                    }

                    const playlists = await response.json();

                    if (playlists.length === 0) {
                        playlistsList.innerHTML = '<div class="alert alert-info">No playlists found</div>';
                        return;
                    }

                    playlists.forEach(playlist => {
                        const item = document.createElement('button');
                        item.type = 'button';
                        item.className = 'list-group-item list-group-item-action';
                        item.textContent = playlist.name;
                        item.dataset.id = playlist.id;

                        item.addEventListener('click', () => {
                            // Remove active class from all items
                            document.querySelectorAll('.list-group-item').forEach(i => {
                                i.classList.remove('active');
                            });

                            // Add active class to clicked item
                            item.classList.add('active');

                            // Show selected playlist
                            currentSelectedId = playlist.id;
                            selectedPlaylistName.textContent = playlist.name;
                            selectedPlaylist.classList.remove('d-none');
                        });

                        playlistsList.appendChild(item);
                    });

                } catch (err) {
                    console.error('Load playlists error:', err);
                    playlistsError.textContent = 'Network error: ' + err.message;
                    playlistsError.classList.remove('d-none');
                } finally {
                    loadPlaylistsBtn.disabled = false;
                    playlistsLoading.classList.add('d-none');
                }
            });
        </script>
    }
}

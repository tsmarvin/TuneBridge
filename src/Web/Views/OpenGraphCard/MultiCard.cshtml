@model IReadOnlyList<TuneBridge.Domain.Contracts.DTOs.MediaLinkResult>
@{
    Layout = null;
    var columns = ViewBag.Columns as int? ?? 3;
    var multiCardId = ViewBag.MultiCardId as string ?? "";
    var baseUrl = ViewBag.BaseUrl as string ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>TuneBridge - Music Links</title>
    <link rel="stylesheet" href="~/public/docfx.min.css">
    <link rel="stylesheet" href="~/public/main.css">
    <link rel="stylesheet" href="~/public/TuneBridge.styles.css">
    <script>
        // FOUC mitigation: Apply theme before page render
        // NOTE: This logic must stay synchronized with docfx.min.js theme management
        const theme = localStorage.getItem('theme') || 'auto'
        document.documentElement.setAttribute('data-bs-theme', theme === 'auto' ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light') : theme)
    </script>
    <style>
        body {
            margin: 0;
            padding: 1rem;
            background: var(--bs-body-bg);
            font-family: system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
        }
        
        .multi-card-container {
            max-width: 100%;
            margin: 0 auto;
        }

        .multi-card-grid {
            display: grid;
            grid-template-columns: repeat(@columns, 1fr);
            gap: 1rem;
            width: 100%;
        }

        /* Responsive breakpoints */
        @@media (max-width: 1200px) {
            .multi-card-grid {
                grid-template-columns: repeat(min(@columns, 3), 1fr);
            }
        }

        @@media (max-width: 992px) {
            .multi-card-grid {
                grid-template-columns: repeat(min(@columns, 2), 1fr);
            }
        }

        @@media (max-width: 768px) {
            .multi-card-grid {
                grid-template-columns: 1fr;
            }
        }

        .multi-card-iframe {
            width: 100%;
            height: 225px;
            border: none;
            border-radius: 0.375rem;
        }
    </style>
</head>
<body>
    <div class="multi-card-container">
        <div class="multi-card-grid">
            @foreach (var result in Model)
            {
                var rkey = TuneBridge.Domain.Implementations.Utilities.RecordKeyGenerator.GenerateRkey(result);
                var cardId = TuneBridge.Domain.Implementations.Utilities.RecordKeyGenerator.GenerateCardId(rkey);
                var embedUrl = $"https://{baseUrl}/card/{cardId}/embed";
                
                <iframe 
                    src="@embedUrl" 
                    class="multi-card-iframe" 
                    allowtransparency="true" 
                    title="Music Card"
                    loading="lazy">
                </iframe>
            }
        </div>
    </div>
</body>
</html>

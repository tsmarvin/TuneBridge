@using TuneBridge.Domain.Types.Enums
@using TuneBridge.Domain.Implementations.Extensions
@using Microsoft.AspNetCore.Html
@{
    Layout = null;
    var result = Model.Result as TuneBridge.Domain.Contracts.DTOs.MediaLinkResult;
    var primaryProvider = (SupportedProviders)Model.PrimaryProvider;
    var primaryResult = Model.PrimaryResult as TuneBridge.Domain.Contracts.DTOs.MusicLookupResultDto;
    var cardUrl = Model.CardUrl as string;
    var atProtoUri = Model.ATProtoUri as string;
    var borderColor = GetProviderColor(primaryProvider);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(primaryResult?.Title ?? "Music Card")</title>
    <link rel="stylesheet" href="~/public/docfx.min.css">
    <link rel="stylesheet" href="~/public/main.css">
    <link rel="stylesheet" href="~/public/TuneBridge.styles.css">
    <script>
        // FOUC mitigation: Apply theme before page render
        // NOTE: This logic must stay synchronized with docfx.min.js theme management
        const theme = localStorage.getItem('theme') || 'auto'
        document.documentElement.setAttribute('data-bs-theme', theme === 'auto' ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light') : theme)
    </script>
    <style>
        body {
            margin: 0;
            padding: 0.5rem;
            background: transparent;
            font-family: system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
        }
        
        /* Ensure card fits in iframe */
        .embed-card {
            max-width: 100%;
            margin: 0;
        }
    </style>
</head>
<body>
    <div class="embed-card" style="border-left-color: @borderColor;">
        <div class="embed-header-top">
            <div class="embed-title-row">
                @if (!string.IsNullOrWhiteSpace(cardUrl))
                {
                    <a href="@cardUrl" target="_blank" rel="noopener noreferrer" class="embed-title">
                        @(primaryResult?.Title ?? "Unknown Title")
                    </a>
                }
                else
                {
                    <div class="embed-title">@(primaryResult?.Title ?? "Unknown Title")</div>
                }
            </div>
        </div>
        <div class="embed-header">
            @if (!string.IsNullOrWhiteSpace(primaryResult?.ArtUrl))
            {
                @if (!string.IsNullOrWhiteSpace(cardUrl))
                {
                    <a href="@cardUrl" target="_blank" rel="noopener noreferrer">
                        <img src="@primaryResult.ArtUrl" alt="@primaryResult.Title artwork" class="embed-image" />
                    </a>
                }
                else
                {
                    <img src="@primaryResult.ArtUrl" alt="@primaryResult.Title artwork" class="embed-image" />
                }
            }
            <div class="embed-content">
                <div class="embed-info">
                    Artist: @(primaryResult?.Artist ?? "Unknown")
                    @if (!string.IsNullOrWhiteSpace(primaryResult?.ExternalId))
                    {
                        var idType = primaryResult.IsAlbum == true ? "UPC" : "ISRC";
                        <text><br /></text>@idType<text>: </text>@primaryResult.ExternalId
                    }
                </div>
            </div>
        </div>
        <div class="embed-providers">
            @if (result != null)
            {
                foreach (var providerResult in result.Results)
                {
                    <a href="@providerResult.Value.URL" target="_blank" rel="noopener noreferrer" class="provider-button">
                        <span class="provider-icon provider-icon-@providerResult.Key.ToString().ToLowerInvariant()">
                            @GetProviderLogo(providerResult.Key)
                        </span>
                        <span class="visually-hidden">@providerResult.Key.GetDescription()</span>
                    </a>
                }
            }
        </div>
    </div>
</body>
</html>

@functions {
    IHtmlContent GetProviderLogo(SupportedProviders provider)
    {
        // Use light theme logos by default, CSS will handle dark theme switching via display property
        var lightThemeLogo = provider switch
        {
            SupportedProviders.AppleMusic => "/public/providerIcons/US-UK_Apple_Music_Listen_on_Lockup_RGB_blk_072720.svg",
            SupportedProviders.Spotify => "/public/providerIcons/Spotify_Full_Logo_Green_CMYK.svg",
            SupportedProviders.Tidal => "/public/providerIcons/tidal-horizontal-black-cmyk.png",
            _ => ""
        };

        var darkThemeLogo = provider switch
        {
            SupportedProviders.AppleMusic => "/public/providerIcons/US-UK_Apple_Music_Listen_on_Lockup_RGB_wht_072720.svg",
            SupportedProviders.Spotify => "/public/providerIcons/Spotify_Full_Logo_Green_RGB.svg",
            SupportedProviders.Tidal => "/public/providerIcons/tidal-horizontal-white-cmyk.png",
            _ => ""
        };

        return new HtmlString($@"
            <img src=""{lightThemeLogo}"" alt=""{provider.GetDescription()}"" class=""provider-logo provider-logo-light"" />
            <img src=""{darkThemeLogo}"" alt=""{provider.GetDescription()}"" class=""provider-logo provider-logo-dark"" />
        ");
    }

    string GetProviderColor(SupportedProviders provider)
    {
        return provider switch
        {
            SupportedProviders.AppleMusic => "#FA233B",
            SupportedProviders.Spotify => "#1DB954",
            SupportedProviders.Tidal => "#000000",
            _ => "#6c757d"
        };
    }
}

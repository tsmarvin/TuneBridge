@model BridgeBeats.Web.Models.PlaylistsViewModel
@{
    ViewData["Title"] = "My Playlists";
    var cspNonce = Context.Items["CSPNonce"] as string ?? string.Empty;
}

<div class="card mb-4">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="card-title mb-0">My Playlists</h2>
            <a href="/playlists/applemusic" class="btn btn-outline-primary">
                Apple Music
            </a>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger" role="alert">
                @Model.ErrorMessage
            </div>
        }

        @if (Model.Playlists.Count == 0 && string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="text-center py-5">
                <p class="text-muted mb-3">You haven't created any playlists yet.</p>
                <a href="/" class="btn btn-primary">Start Creating Playlists</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Description</th>
                            <th>Items</th>
                            <th>Created</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var playlist in Model.Playlists)
                        {
                            <tr id="playlist-@playlist.PlaylistId">
                                <td>
                                    <a href="@playlist.PlaylistUrl" target="_blank" rel="noopener noreferrer">
                                        @playlist.Title
                                    </a>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(playlist.Description))
                                    {
                                        <span class="text-muted">@playlist.Description</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic">No description</span>
                                    }
                                </td>
                                <td>@playlist.ItemCount</td>
                                <td>
                                    <span title="@playlist.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss UTC")">
                                        @playlist.CreatedAt.ToString("yyyy-MM-dd")
                                    </span>
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a href="@playlist.PlaylistUrl" class="btn btn-sm btn-outline-primary" target="_blank" rel="noopener noreferrer">
                                            View
                                        </a>
                                        <button type="button" class="btn btn-sm btn-outline-secondary copy-playlist-link" data-url="@playlist.PlaylistUrl">
                                            Copy Link
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-danger delete-playlist" data-id="@playlist.PlaylistId">
                                            Delete
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script nonce="@cspNonce">
        // Copy playlist link
        document.querySelectorAll('.copy-playlist-link').forEach(btn => {
            btn.addEventListener('click', async () => {
                const url = btn.getAttribute('data-url');
                try {
                    await navigator.clipboard.writeText(url);
                    const originalText = btn.textContent;
                    btn.textContent = 'Copied!';
                    btn.classList.add('btn-success');
                    btn.classList.remove('btn-outline-secondary');
                    setTimeout(() => {
                        btn.textContent = originalText;
                        btn.classList.remove('btn-success');
                        btn.classList.add('btn-outline-secondary');
                    }, 2000);
                } catch (err) {
                    console.error('Failed to copy:', err);
                    alert('Failed to copy link to clipboard');
                }
            });
        });

        // Delete playlist
        document.querySelectorAll('.delete-playlist').forEach(btn => {
            btn.addEventListener('click', async () => {
                const playlistId = btn.getAttribute('data-id');
                if (!confirm('Are you sure you want to delete this playlist? This action cannot be undone.')) {
                    return;
                }

                try {
                    const response = await fetch(`/playlists/${playlistId}/delete`, {
                        method: 'POST',
                        credentials: 'same-origin'
                    });

                    if (response.ok) {
                        // Remove the row from the table
                        const row = document.getElementById(`playlist-${playlistId}`);
                        if (row) {
                            row.remove();
                        }

                        // Check if table is empty now
                        const tbody = document.querySelector('tbody');
                        if (tbody && tbody.children.length === 0) {
                            location.reload();
                        }
                    } else {
                        const data = await response.json().catch(() => ({ error: 'Failed to delete playlist' }));
                        alert(data.error || 'Failed to delete playlist');
                    }
                } catch (err) {
                    console.error('Error deleting playlist:', err);
                    alert('Failed to delete playlist');
                }
            });
        });
    </script>
}

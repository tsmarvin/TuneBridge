{
  "TuneBridge": {
    "NodeNumber": {NodeNumber},
    "AppleTeamId": "{AppleTeamId}",
    "AppleKeyId": "{AppleKeyId}",
    "AppleKeyPath": "{AppleKeyPath}",
    "SpotifyClientId": "{SpotifyClientId}",
    "SpotifyClientSecret": "{SpotifyClientSecret}",
    "TidalClientId": "{TidalClientId}",
    "TidalClientSecret": "{TidalClientSecret}",
    "DiscordToken": "{DiscordToken}",
    "IdentityConnectionString": "Data Source=tunebridge.db",
    "ApiKeySalt": "{ApiKeySalt}",
    "RateLimitRequestsPerHour": 20,
    "ATProtoIdentifier": "{ATProtoIdentifier}",
    "ATProtoPassword": "{ATProtoPassword}",
    "CacheDays": 7,
    "LinkCacheConnectionString": "tunebridge.db",
    "BaseUrl": "{BaseUrl}"
  },
  "Logging": {
    "LogLevel": {
      "Default": "{Default_LogLevel}",
      "Microsoft.Hosting.Lifetime": "{Hosting_LogLevel}"
    }
  },
  "AllowedHosts": "{Allowed_Hosts}"
}

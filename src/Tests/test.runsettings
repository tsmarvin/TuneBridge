<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <!-- MSTest adapter settings -->
  <MSTest>
    <!-- Set global test timeout to 2 minutes (120000 milliseconds) -->
    <TestTimeout>120000</TestTimeout>
  </MSTest>

  <!-- Test execution settings -->
  <RunConfiguration>
    <!-- Maximum number of parallel test workers. 0 = auto-detect based on CPU cores -->
    <MaxCpuCount>0</MaxCpuCount>
    <!-- Results directory for test output -->
    <ResultsDirectory>.\TestResults</ResultsDirectory>
    <!-- Stop test execution on first test failure -->
    <StopOnError>true</StopOnError>
  </RunConfiguration>
</RunSettings>

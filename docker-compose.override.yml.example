# docker-compose.override.yml.example
#
# This file demonstrates how to override docker-compose.yml settings for local development.
# Copy this file to docker-compose.override.yml and customize as needed.
#
# Docker Compose automatically applies overrides from docker-compose.override.yml
# when you run `docker-compose up`.

version: '3.8'

services:
  tunebridge:
    # Override image name for local builds
    image: tunebridge:local
    
    # Use local build instead of pulling from registry
    build:
      context: .
      dockerfile: Dockerfile
    
    # Override ports for local development
    # Expose TuneBridge directly without going through Caddy
    ports:
      - "5000:10000"  # Direct access to TuneBridge
      - "8080:80"     # HTTP through Caddy
      - "8443:443"    # HTTPS through Caddy
    
    # Override environment for local development
    environment:
      # Use localhost for local development
      - DOMAIN=localhost
      
      # More verbose logging for debugging
      - DEFAULT_LOGLEVEL=Debug
      - HOSTING_DEFAULT_LOGLEVEL=Debug
      
      # Override any other settings as needed
      # - RATE_LIMIT_REQUESTS_PER_HOUR=100
    
    # Override volumes for local development
    # Mount local Caddyfile for testing changes without rebuilding
    volumes:
      # Uncomment to use a custom Caddyfile during development
      # - ./Caddyfile:/etc/caddy/Caddyfile:ro
      
      # Mount local data directory for easier access
      # - ./data:/app/data
      
      # Mount local logs for easier debugging
      # - ./logs:/var/log/caddy
    
    # Remove resource limits for local development
    deploy:
      resources:
        limits:
          cpus: '4'
          memory: 2G

# You can also override secrets for local development
# Uncomment and customize as needed
# secrets:
#   apple_key:
#     file: ./local-secrets/apple_key.p8
#   spotify_client_secret:
#     file: ./local-secrets/spotify_client_secret.txt

{
  "metadata": [
    {
      "src": [
        {
          "src": "src",
          "files": [ "**.csproj" ]
        }
      ],
      "dest": "docs/api",
      "disableGitFeatures": false,
      "disableDefaultFilter": false
    }
  ],
  "build": {
    "content": [
      {
        "files": [ "**.{md,yml}" ],
        "src": "docs"
      },
      {
        "files": [ "**.md" ],
        "src": ".",
        "exclude": [ "_site/**" ]
      }
    ],
    "resource": [
      {
        "files": [ "images/**" ],
        "src": "docs"
      },
      {
        "files": [ "favicon.ico" ],
        "src": "src/Web/wwwroot",
        "dest": "."
      },
      {
        "files": [ "public/**" ],
        "src": "src/Web/wwwroot",
        "dest": "."
      }
    ],
    "globalMetadataFiles": [],
    "fileMetadataFiles": [],
    "template": [ "default", "modern" ],
    "postProcessors": [],
    "keepFileLink": false,
    "disableGitFeatures": false,
    "globalMetadata": {
      "_appTitle": "TuneBridge",
      "_appName": "TuneBridge API Documentation",
      "_appFooter": "Copyright © Taylor Marvin (2025)",
      "_enableSearch": true,
      "_appFaviconPath": "favicon.ico"
    }
  }
}
